---
import '../styles/global.css'
const { title = 'Portfolio', description = '' } = Astro.props
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
  </body>
  </html>