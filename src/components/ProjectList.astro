---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { CollectionEntry } from 'astro:content'
interface Props { projects: CollectionEntry<'projects'>[]; headingLevel?: 'h2' | 'h3' }
const { projects, headingLevel = 'h3' } = Astro.props
const Heading = headingLevel
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{jpg,jpeg,png,JPG}', { eager: true })
---
<ul class="project-list">
  {projects.map((project) => {
    const thumbnail = images[`../assets${project.data.thumbnail}`]?.default
    return <li class:list={['project-row', { 'project-row--text-only': !thumbnail }]}>
      <div><Heading class="project-title"><a href={`/projects/${project.slug}/`}>{project.data.title}</a></Heading><p>{project.data.description}</p></div>
      {thumbnail && <div class="project-thumbnail" data-parallax><div class="parallax-frame"><Image src={thumbnail} alt="" width={576} height={324} loading="lazy" /></div></div>}
    </li>
  })}
</ul>
