<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    [data-scroll-reveal] {
      transition: opacity 800ms cubic-bezier(.22, 1, .36, 1), translate 800ms cubic-bezier(.22, 1, .36, 1);
    }
    [data-scroll-reveal="pending"] { opacity: 0; translate: 0 8px; transition: none; }
    [data-scroll-reveal="revealed"] { opacity: 1; translate: 0 0; }
    [data-scroll-reveal="pending"]:focus-within { opacity: 1; translate: none; transition: none; }
  }
  @media print {
    [data-scroll-reveal] { opacity: 1 !important; translate: none !important; transition: none !important; }
  }
</style>

<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)')
  if (!motion.matches && 'IntersectionObserver' in window) {
    const selector = 'main h1, main h2, main h3, main h4, main p, main li, main figure, main blockquote, main pre, main table, main dt, main dd, main .technology-group, main .project-gallery, main .project-screens, main .profile-links, main .article-contents, main .project-actions, main .app-campaign, .site-footer'
    const candidates = Array.from(document.querySelectorAll<HTMLElement>(selector)).filter((element) =>
      !element.parentElement?.closest('dialog, .screenshot-deck, .project-screens, .project-gallery, [hidden], [aria-hidden="true"]')
    )
    const targets = candidates.filter((element) => !element.parentElement?.closest(selector))
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const target = entry.target as HTMLElement
        target.dataset.scrollReveal = 'revealed'
        observer.unobserve(entry.target)
      })
    }, { rootMargin: '0px 0px -24px 0px', threshold: 0 })
    targets.forEach((element) => {
      const rect = element.getBoundingClientRect()
      if (rect.height === 0 || rect.top < innerHeight || element.contains(document.activeElement)) return
      element.dataset.scrollReveal = 'pending'
      observer.observe(element)
    })
    const showImmediately = (element: Element | null) => {
      if (!element) return
      const blocks = [element.closest<HTMLElement>('[data-scroll-reveal]'), ...element.querySelectorAll<HTMLElement>('[data-scroll-reveal]')]
      blocks.forEach((block) => {
        if (!block) return
        delete block.dataset.scrollReveal
        observer.unobserve(block)
      })
    }
    document.addEventListener('focusin', (event) => showImmediately(event.target as Element))
    const showAnchor = () => {
      let id: string
      try { id = decodeURIComponent(location.hash.slice(1)) } catch { return }
      showImmediately(document.getElementById(id))
    }
    addEventListener('hashchange', showAnchor)
    showAnchor()
    motion.addEventListener('change', () => {
      if (!motion.matches) return
      observer.disconnect()
      targets.forEach((element) => { delete element.dataset.scrollReveal })
    })
  }
</script>
