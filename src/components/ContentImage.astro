---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
interface Props { src: string; alt: string; eager?: boolean }
const { src, alt, eager = false } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{jpg,jpeg,png,JPG}', { eager: true })
const image = images[`../assets${src}`]?.default
---
{image ? <Image src={image} alt={alt} widths={[480, 800, 1600]} sizes="(max-width: 740px) calc(100vw - 40px), 720px" width={Math.min(image.width, 1600)} loading={eager ? 'eager' : 'lazy'} /> : <img src={src} alt={alt} width="1600" height="900" loading={eager ? 'eager' : 'lazy'} />}
