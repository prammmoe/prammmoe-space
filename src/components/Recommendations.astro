---
import { recommendations } from '../data/recommendations'
import { profile, formatDate } from '../data/profile'
---
<section class="home-section" id="recommendations" aria-labelledby="recommendations-heading">
  <div class="section-heading"><h2 id="recommendations-heading">Recommendations</h2><a href={profile.links.linkedin}>View on LinkedIn</a></div>
  <div class="recommendations-list">
    {recommendations.map((item) => <figure class="recommendation">
      <blockquote cite={profile.links.linkedin}><p>“{item.quote}”</p></blockquote>
      <figcaption>
        <strong>{item.name}</strong>
        <span>{item.role}</span>
        <span>{item.relationship}</span>
        <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
      </figcaption>
    </figure>)}
  </div>
</section>

<style>
  h2 { color: #007bff; }
  :global(:root[data-theme="dark"]) h2 { color: #70b5ff; }
  .recommendations-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .recommendation { display: flex; flex-direction: column; gap: 24px; min-width: 0; margin: 0; padding: 24px; border: 1px solid var(--rule); border-radius: 12px; background: var(--surface); }
  .recommendation blockquote { margin: 0; padding: 0; border: 0; }
  .recommendation blockquote p { margin: 0; color: var(--ink); font-size: 17px; line-height: 1.7; }
  .recommendation figcaption { display: grid; gap: 4px; margin-top: auto; font-size: 14px; line-height: 1.6; }
  .recommendation strong { color: var(--ink); font-weight: 600; }
  @media (max-width: 600px) {
    .recommendations-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
