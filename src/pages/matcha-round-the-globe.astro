---
import ScrollReveal from '../components/ScrollReveal.astro'
const stops = [
  ['Asha Tea House', 'San Francisco', 'United States', 'sf'], ['Black Bird Bookstore', 'San Francisco', 'United States', 'sf'], ['Kiss of Matcha', 'San Francisco', 'United States', 'sf'], ['Best Boy Electric', 'San Francisco', 'United States', 'sf'], ['Postscript', 'San Francisco', 'United States', 'sf'], ['Little Sweet', 'San Francisco', 'United States', 'sf'], ['Wake Cup', 'San Francisco', 'United States', 'sf'], ['Binge Coffee House', 'San Francisco', 'United States', 'sf'], ['Tadaima', 'San Francisco', 'United States', 'sf'], ['Nagomi', 'San Francisco', 'United States', 'sf'], ['Home Coffee Roasters', 'San Francisco', 'United States', 'sf'], ['Maruwu Seicha', 'San Francisco', 'United States', 'sf'], ['Sōhn', 'San Francisco', 'United States', 'sf'], ['Capital One Café', 'San Francisco', 'United States', 'sf'], ['Komeya No Bento', 'San Francisco', 'United States', 'sf'], ['Sightglass Coffee', 'San Francisco', 'United States', 'sf'], ['Stonemill Matcha', 'San Francisco', 'United States', 'sf'], ['Pixlcat Coffee', 'San Francisco', 'United States', 'sf'],
  ['12 Matcha', 'New York City', 'United States', 'nyc'], ['Cha Cha Matcha', 'New York City', 'United States', 'nyc'], ['Nana’s Green Tea', 'New York City', 'United States', 'nyc'], ['Isshiki Matcha', 'New York City', 'United States', 'nyc'], ['Brioche NYC', 'New York City', 'United States', 'nyc'], ['King’s Coffee', 'New York City', 'United States', 'nyc'], ['Matchaful', 'New York City', 'United States', 'nyc'], ['Mika’s Direction', 'New York City', 'United States', 'nyc'], ['Mori Coffee', 'New York City', 'United States', 'nyc'],
  ['Summer Studios', 'Tokyo', 'Japan', 'tokyo'], ['Wasachi', 'Tokyo', 'Japan', 'tokyo'], ['Nakamura Tokichi', 'Tokyo', 'Japan', 'tokyo'], ['Three', 'Tokyo', 'Japan', 'tokyo'], ['Savor the Matcha', 'Tokyo', 'Japan', 'tokyo'], ['Lambert', 'Tokyo', 'Japan', 'tokyo'],
  ['Sannolu', 'Seoul', 'South Korea', 'seoul'], ['Osulloc Tea House 1979', 'Seoul', 'South Korea', 'seoul'], ['Super Matcha Seongsu', 'Seoul', 'South Korea', 'seoul'], ['METCHA', 'Seoul', 'South Korea', 'seoul'], ['Matchacha', 'Seoul', 'South Korea', 'seoul'], ['Townpond', 'Seoul', 'South Korea', 'seoul'], ['Korz', 'Seoul', 'South Korea', 'seoul'], ['Long Vacation', 'Seoul', 'South Korea', 'seoul'], ['Cafe J The Matcha House', 'Seoul', 'South Korea', 'seoul'], ['Fou de Thé', 'Seoul', 'South Korea', 'seoul'],
  ['San Java 2.0', 'Sydney', 'Australia', 'sydney'], ['Chubby Cubby Cafe', 'Sydney', 'Australia', 'sydney'], ['Noon', 'Sydney', 'Australia', 'sydney'], ['Mamuki', 'Sydney', 'Australia', 'sydney'], ['Matcha-Ya', 'Sydney', 'Australia', 'sydney'], ['Blackwood', 'Sydney', 'Australia', 'sydney'], ['Cafe Kentaro', 'Sydney', 'Australia', 'sydney'], ['TenTo', 'Sydney', 'Australia', 'sydney'], ['Oh!Matcha', 'Sydney', 'Australia', 'sydney'], ['Makers Daily', 'Sydney', 'Australia', 'sydney'], ['Rushi', 'Sydney', 'Australia', 'sydney'], ['Cafe Oratnek', 'Sydney', 'Australia', 'sydney'], ['Harry’s', 'Sydney', 'Australia', 'sydney'],
  ['Taz Matcha', 'Seattle', 'United States', 'global'], ['Jenki', 'London', 'United Kingdom', 'global'], ['Icha Tea', 'Toronto', 'Canada', 'global'], ['Neo Coffee Bar', 'Toronto', 'Canada', 'global'], ['Tsujiri', 'Kyoto', 'Japan', 'global'], ['Maccha House', 'Kyoto', 'Japan', 'global'], ['Saryo Tsujiri', 'Kyoto', 'Japan', 'global'],
]

const wishTails = [
  'feel like a quiet reward for every brave thing you do.', 'remind you that your dreams deserve beautiful pit stops.', 'give your busy heart a soft little place to land.', 'taste like a green postcard from a future adventure.', 'make an ordinary afternoon feel wonderfully yours.', 'bring you one more reason to look forward to the world.', 'be paired with a view that makes you smile without trying.', 'turn a long walk into a memory worth keeping.', 'make space for your sweetest, slowest kind of joy.', 'be one tiny celebration of how far you have come.',
  'be the start of a trip we tell stories about for years.', 'make your ambitious plans feel even more exciting.', 'give you a peaceful pause between all your big wins.', 'come with a window seat, good light, and no rush at all.', 'be as lovely and bright as your prettiest smile.', 'remind you that rest can be part of the adventure too.', 'make you feel cherished in a city that is new to you.', 'bring a little sparkle to your already beautiful life.', 'help you collect another favorite corner of the world.', 'feel like a toast to the woman you are becoming.',
  'be followed by laughter, photos, and a very happy Nana.', 'make a rainy day feel softer and sunnier.', 'give you the kind of calm that stays after the last sip.', 'be a delicious excuse to wander somewhere beautiful.', 'come with a view worthy of your camera roll.', 'make your curiosity feel completely at home.', 'be the pause that helps every new idea bloom.', 'remind you that the world has so many lovely things waiting.', 'make you feel as adored as you truly are.', 'be enjoyed with the same care you put into your dreams.',
  'bring you a gentle moment before your next bold move.', 'make a faraway city feel a little more familiar.', 'come with a perfect playlist and an even better mood.', 'feel like proof that hard work can lead to sweet places.', 'help you enjoy the view without checking the time.', 'give your clever mind a bright green reset.', 'be the beginning of a day full of unexpected good news.', 'make you proud of the life you are building.', 'come with sunshine, fresh air, and a reason to linger.', 'feel like a small luxury made especially for you.',
  'make your inner child and grown-up self equally happy.', 'be a reminder that you do not have to rush beautiful things.', 'turn a simple stop into a tiny love story.', 'give you a calm moment after every ambitious season.', 'taste even better because you got there with courage.', 'make room for one more inside joke between us.', 'help you see the world with the same wonder you bring to mine.', 'be served alongside the softest kind of happiness.', 'make the next chapter of your travels feel bright and breezy.', 'be a little green flag that life is treating you well.',
  'come after a day when you are proud of yourself.', 'make you feel spoiled in the gentlest possible way.', 'be the kind of treat that turns into a tradition.', 'give you a beautiful reason to slow down and look around.', 'be another destination your future self will thank you for.', 'make your hard work feel beautifully worth it.', 'bring you calm confidence for whatever comes next.', 'be a tiny reminder that you deserve a big, joyful life.', 'make the sky, the city, and your smile feel extra blue and bright.', 'be one more lovely wish finding its way to you.', 'bring you the kind of joy that travels well.', 'be a peaceful landmark in a future favorite city.', 'remind you that every dream trip can start with one small sip.',
]

const destinations = stops.map(([cafe, city, country], index) => {
  const query = encodeURIComponent(`${cafe}, ${city}, ${country}`)
  return { cafe, city, country, mapUrl: `https://www.google.com/maps/search/?api=1&query=${query}`, wish: `May you (and me also XD) drink matcha at ${cafe} in ${city}, ${country}, and let it ${wishTails[index]}` }
})

if (destinations.length < 60 || new Set(destinations.map(({ cafe, city }) => `${cafe}-${city}`)).size !== destinations.length) throw new Error('Voucher 003 needs at least 60 unique matcha destinations.')
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Voucher 003 — Matcha Globe Explorer</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#27aed2" />
  </head>
  <body>
    <audio class="matcha-song" src="/audio/matcha-with-the-sun.mp3" autoplay loop preload="auto"></audio>
    <main class="aero-desk" aria-labelledby="app-title">
      <div class="aero-shine" aria-hidden="true"></div><div class="bubble-field" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <section class="explorer-window">
        <header class="title-bar"><span id="app-title">✦ MATCHA_GLOBE.EXE — Voucher 003</span><span class="window-controls" aria-hidden="true">− □ ×</span></header>
        <nav class="menu-bar" aria-label="Matcha Globe menu"><span>File</span><button class="menu-action all-button" type="button">Open all cafés</button><span>View</span><span>Favorites</span></nav>
        <section class="hero-panel">
          <div class="globe" aria-hidden="true"><span>✦</span><b>✦</b><i>✦</i></div>
          <div class="intro"><p class="eyebrow">NANA’S MATCHA PASSPORT</p><h1>One green wish,<br />one beautiful café.</h1><p>many little reasons to see the world, sip slowly, and smile brightly.</p></div>
        </section>
        <section class="destination-card" aria-live="polite">
          <h2 class="cafe-name">Loading a matcha stop…</h2><p class="location">Somewhere lovely</p><p class="wish-text">A tiny green wish is on its way to you.</p>
          <div class="destination-links"><a class="map-link" href="#" target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a></div>
        </section>
        <div class="controls">
          <button class="aero-button previous" type="button" aria-label="Previous destination">◀ Previous</button><button class="aero-button random" type="button">✦ Random stop</button><button class="aero-button next" type="button">Next ▶</button>
        </div>
        <footer class="status-bar"><span>☘ mapped with love</span><span></span><span>made for Nana ♡</span></footer>
      </section>
      <dialog class="cafe-library" aria-labelledby="library-title">
        <header class="library-titlebar"><strong id="library-title">☘ NANA’S MATCHA WORLD TOUR ☘</strong><button class="library-close" type="button" aria-label="Close café library">×</button></header>
        <div class="library-tools"><label for="cafe-search">Find a café</label><input id="cafe-search" type="search" placeholder="City, country, or café" /></div>
        <p class="library-count">{destinations.length} green destinations waiting for you.</p>
        <ol class="cafe-list">{destinations.map((destination) => <li data-search={`${destination.cafe} ${destination.city} ${destination.country}`.toLowerCase()}><strong>{destination.cafe}</strong><span>{destination.city}, {destination.country}</span><p>{destination.wish}</p><div><a href={destination.mapUrl} target="_blank" rel="noopener noreferrer">Maps ↗</a></div></li>)}</ol>
      </dialog>
    </main>
    <script is:inline define:vars={{ destinationData: destinations }}>
      // @ts-ignore Astro injects this value through define:vars.
      const destinations = [...destinationData]
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const cafeName = document.querySelector('.cafe-name'), location = document.querySelector('.location'), wishText = document.querySelector('.wish-text'), mapLink = document.querySelector('.map-link')
      const audio = document.querySelector('.matcha-song'), library = document.querySelector('.cafe-library'), search = document.querySelector('#cafe-search')
      let order = destinations.map((_, index) => index), position = 0
      const shuffle = (values) => { for (let index = values.length - 1; index > 0; index -= 1) { const swap = Math.floor(Math.random() * (index + 1)); [values[index], values[swap]] = [values[swap], values[index]] } }
      function show(animate = true) { const stop = destinations[order[position]]; cafeName.textContent = stop.cafe; location.textContent = `${stop.city}, ${stop.country}`; wishText.textContent = stop.wish; mapLink.href = stop.mapUrl; wishText.classList.remove('is-moving'); void wishText.offsetWidth; if (animate && !reduceMotion) wishText.classList.add('is-moving') }
      function next() { position += 1; if (position >= order.length) { shuffle(order); position = 0 } show() }
      function previous() { position = position <= 0 ? order.length - 1 : position - 1; show() }
      function randomStop() { const index = position + Math.floor(Math.random() * (order.length - position)); [order[position], order[index]] = [order[index], order[position]]; show() }
      async function startMusic() { if (!audio || !audio.paused) return Boolean(audio); try { audio.volume = 1; await audio.play(); return true } catch { return false } }
      function setTimer() { if (!reduceMotion) window.setInterval(next, 9000) }
      shuffle(order); show(false); setTimer()
      document.querySelector('.next')?.addEventListener('click', next); document.querySelector('.previous')?.addEventListener('click', previous); document.querySelector('.random')?.addEventListener('click', randomStop)
      document.querySelector('.all-button')?.addEventListener('click', () => library?.showModal()); document.querySelector('.library-close')?.addEventListener('click', () => library?.close())
      search?.addEventListener('input', () => document.querySelectorAll('.cafe-list li').forEach((item) => { item.hidden = !item.dataset.search.includes(search.value.toLowerCase().trim()) }))
      void startMusic().then((started) => { if (!started) window.addEventListener('pointerdown', () => void startMusic(), { once: true }) })
    </script>
    <ScrollReveal />
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; } :global(html), :global(body) { min-height: 100%; } :global(body) { margin: 0; color: #073a52; font-family: 'Myriad Pro', 'Myriad Set Pro', 'Myriad Apple', Myriad, 'Helvetica Neue', Arial, sans-serif; }
  .aero-desk, .aero-desk * { -moz-osx-font-smoothing: unset; -webkit-font-smoothing: none; font-family: 'Myriad Pro', 'Myriad Set Pro', 'Myriad Apple', Myriad, 'Helvetica Neue', Arial, sans-serif !important; font-smooth: never; text-rendering: optimizeSpeed; }
  .aero-desk { align-items:center; background:#0475b9 url('/images/matcha-frutiger-aero-skyline.png') center / cover fixed no-repeat; display:flex; justify-content:center; min-height:100vh; overflow:hidden; padding:clamp(1rem,4vw,3.5rem) 1rem; position:relative; }
  .aero-desk::before { background:linear-gradient(115deg,rgba(0,51,112,.24),transparent 36%,rgba(0,127,191,.1) 67%,rgba(1,78,138,.26)), radial-gradient(ellipse at center,transparent 25%,rgba(0,45,104,.22)); content:''; inset:0; pointer-events:none; position:absolute; } .aero-desk::after { background:linear-gradient(108deg,transparent 39%,rgba(255,255,255,.33) 48%,transparent 55%); content:''; height:160%; left:-70%; pointer-events:none; position:absolute; top:-31%; transform:rotate(-14deg); width:40%; }
  .aero-shine { animation:shine-pass 11s ease-in-out infinite; background:radial-gradient(ellipse,rgba(255,255,255,.44),transparent 68%); height:19rem; pointer-events:none; position:absolute; right:5%; top:-7rem; width:30rem; }
  .bubble-field { inset:0; overflow:hidden; pointer-events:none; position:absolute; }.bubble-field i { animation:bob 7s ease-in-out infinite alternate; background:radial-gradient(circle at 35% 25%,#fff 0 5%,rgba(255,255,255,.47) 7%,rgba(181,248,255,.11) 40%,rgba(0,127,198,.28)); border:1px solid rgba(255,255,255,.87); border-radius:50%; box-shadow:inset -8px -8px 12px rgba(1,130,196,.18),0 4px 10px rgba(2,45,105,.32); height:clamp(2rem,5vw,4.8rem); left:var(--x); position:absolute; top:var(--y); width:clamp(2rem,5vw,4.8rem); }.bubble-field i:nth-child(1){--x:5%;--y:62%}.bubble-field i:nth-child(2){--x:16%;--y:31%;animation-delay:-2s}.bubble-field i:nth-child(3){--x:81%;--y:11%;animation-delay:-3s}.bubble-field i:nth-child(4){--x:89%;--y:65%;animation-delay:-5s}.bubble-field i:nth-child(5){--x:70%;--y:77%;animation-delay:-1s}.bubble-field i:nth-child(6){--x:29%;--y:83%;animation-delay:-4s}
  .explorer-window { backdrop-filter:blur(12px) saturate(1.28); background:linear-gradient(135deg,rgba(226,255,255,.82),rgba(63,188,226,.58) 46%,rgba(224,255,239,.72)); border:2px solid rgba(255,255,255,.92); border-radius:14px 14px 9px 9px; box-shadow:0 0 0 2px rgba(0,75,154,.72),0 24px 50px rgba(0,31,84,.53),inset 0 0 0 2px rgba(255,255,255,.63),inset 0 14px 20px rgba(255,255,255,.2); max-width:57rem; padding:.45rem; position:relative; width:min(100%,57rem); z-index:1; }.title-bar,.library-titlebar { align-items:center; background:linear-gradient(180deg,#dcfcff 0%,#64d5f4 36%,#0879c4 54%,#20a8df 100%); border:1px solid #f3ffff; border-radius:10px 10px 3px 3px; box-shadow:inset 0 2px rgba(255,255,255,.94),inset 0 -2px rgba(0,78,162,.26); color:#fff; display:flex; font-family:'Trebuchet MS',Arial,sans-serif; font-size:clamp(.73rem,2vw,.95rem); font-weight:bold; justify-content:space-between; letter-spacing:.04em; padding:.45rem .62rem; text-shadow:1px 1px #075183; }.window-controls { background:linear-gradient(#fbffff,#a8e8f5); border:1px solid #fff; border-radius:4px; box-shadow:inset 0 1px #fff; color:#075183; letter-spacing:.2em; padding:.02rem .26rem; text-shadow:none; }.menu-bar { align-items:center; background:linear-gradient(rgba(255,255,255,.94),rgba(198,242,247,.82)); border:1px solid #74c6d6; display:flex; font-size:.74rem; gap:1rem; margin-top:.38rem; padding:.36rem .55rem; }.menu-bar strong { color:#087747; margin-left:auto; }.menu-action { background:none; border:0; color:inherit; cursor:pointer; font:inherit; padding:0; text-decoration:underline; text-underline-offset:2px; }
  .hero-panel { align-items:center; background:linear-gradient(115deg,rgba(255,255,255,.87),rgba(176,255,221,.61)),radial-gradient(circle at 84% 16%,#fff 0 3%,transparent 4%); border:1px solid #baffdc; box-shadow:inset 0 0 20px rgba(73,255,204,.38),inset 0 1px #fff; display:flex; gap:clamp(1rem,4vw,3rem); margin-top:.4rem; min-height:10.5rem; overflow:hidden; padding:1rem clamp(1rem,4vw,2.6rem); position:relative; }.hero-panel::after { background:linear-gradient(90deg,transparent,rgba(255,255,255,.78),transparent); content:''; height:160%; position:absolute; right:20%; top:-33%; transform:rotate(18deg); width:3rem; }.globe { background:radial-gradient(circle at 35% 27%,#eaffff 0 5%,transparent 6%),radial-gradient(circle at 58% 45%,#68e470 0 15%,transparent 16%),radial-gradient(circle at 22% 68%,#2fb0db 0 23%,transparent 24%),linear-gradient(135deg,#acfbff,#168ac9); border:3px solid #eaffff; border-radius:50%; box-shadow:inset -12px -12px 20px rgba(2,66,126,.24),0 8px 13px rgba(0,75,113,.28); flex:0 0 clamp(6rem,16vw,9rem); height:clamp(6rem,16vw,9rem); position:relative; }.globe::before,.globe::after { border:1px solid rgba(255,255,255,.83); border-radius:50%; content:''; inset:-13%; position:absolute; transform:rotate(-22deg) scaleY(.35); }.globe::after { animation:orbit 6s linear infinite; inset:-22%; transform:rotate(30deg) scaleY(.28); }.globe span,.globe b,.globe i { color:#fffcc1; font-style:normal; position:absolute; text-shadow:0 0 6px #fff; }.globe span{left:18%;top:16%}.globe b{right:18%;top:50%}.globe i{left:42%;bottom:14%}.intro { position:relative; z-index:1; }.eyebrow { color:#087b67; font-family:'Trebuchet MS',Arial,sans-serif; font-size:.68rem; font-weight:bold; letter-spacing:.12em; margin:0; }.intro h1 { color:#087a55; font-family:Georgia,serif; font-size:clamp(1.6rem,4.6vw,3rem); font-style:italic; line-height:.94; margin:.45rem 0; text-shadow:1px 2px #fff; }.intro p:last-child { font-size:clamp(.78rem,1.8vw,.98rem); margin:0; max-width:30rem; }
  .destination-card { background:linear-gradient(150deg,rgba(255,255,255,.94),rgba(194,253,235,.8)); border:2px solid #9bf1d2; border-radius:0 0 16px 16px; box-shadow:inset 0 0 0 2px rgba(255,255,255,.8),inset 0 -12px 24px rgba(49,210,144,.12),0 4px 12px rgba(0,81,133,.14); margin-top:.4rem; overflow:hidden; padding:clamp(1rem,3vw,1.65rem); position:relative; text-align:center; }.destination-card::before { background:radial-gradient(circle,#fff 0 1px,transparent 2px) 0 0/13px 13px; content:''; inset:0; opacity:.45; pointer-events:none; position:absolute; }.destination-card>* { position:relative; }.cafe-name { color:#006f57; font-family:Georgia,serif; font-size:clamp(1.65rem,5vw,3rem); font-style:italic; line-height:1.03; margin:.35rem auto 0; text-shadow:1px 2px #fff,0 0 12px rgba(79,251,196,.65); }.location { color:#1389a7; font-weight:bold; margin:.32rem 0 1rem; }.wish-text { color:#07506a; font-family:Georgia,serif; font-size:clamp(1.05rem,2.6vw,1.45rem); line-height:1.4; margin:0 auto; max-width:46rem; }.wish-text.is-moving { animation:slide-in .7s cubic-bezier(.15,.85,.2,1) both; }.destination-links { display:flex; flex-wrap:wrap; gap:.55rem; justify-content:center; margin-top:1.1rem; }.destination-links a,.cafe-list a { color:#006fa4; font-weight:bold; }.destination-links a { background:linear-gradient(#fff,#9fe7f1); border:1px solid #67bcc7; border-radius:100vw; box-shadow:inset 0 1px #fff,0 2px 2px rgba(3,91,120,.22); padding:.42rem .73rem; text-decoration:none; }
  .controls { display:flex; flex-wrap:wrap; gap:.5rem; justify-content:center; padding:.7rem .1rem .25rem; }.aero-button { background:linear-gradient(#fff 0%,#d9ffff 35%,#71d7e7 52%,#2aafc9 100%); border:1px solid #dfffff; border-radius:100vw; box-shadow:inset 0 1px #fff, 0 2px 3px rgba(0,65,118,.44); color:#00506d; cursor:pointer; font-family:'Trebuchet MS',Arial,sans-serif; font-size:clamp(.68rem,1.8vw,.8rem); font-weight:bold; min-height:2.15rem; padding:.4rem .72rem; text-shadow:1px 1px #fff; }.aero-button:hover,.aero-button[aria-pressed='true'] { background:linear-gradient(#fff,#b8ffcf 35%,#49ca87 52%,#12965b); color:#00513d; }.aero-button:active { box-shadow:inset 0 2px 5px rgba(0,81,114,.42); transform:translateY(1px); }.status-bar { align-items:center; background:linear-gradient(#efffff,#b8e8ed); border:1px solid #72b8c4; display:flex; font-size:.65rem; gap:.4rem; justify-content:space-between; margin-top:.35rem; padding:.3rem .5rem; }.status-bar a { text-align:center; }
