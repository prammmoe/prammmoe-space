---
import Base from '../../layouts/Base.astro'
import ProjectGallery from '../../components/ProjectGallery.astro'
import ContentImage from '../../components/ContentImage.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { formatDate } from '../../data/profile'
export async function getStaticPaths() { return (await getCollection('projects')).filter((project) => !project.data.draft).map((project) => ({ params: { slug: project.slug }, props: { project } })) }
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props
const { Content, headings } = await project.render()
const sections = headings.filter((heading) => heading.depth === 2)
---
<Base title={project.data.title} description={project.data.description}>
  <article class="project-detail">
    <a class="back-link" href="/projects/">Back to projects</a>
    <header class="article-header"><h1>{project.data.title}</h1><p class="description">{project.data.description}</p><p class="meta"><time datetime={project.data.pubDate.toISOString()}>{formatDate(project.data.pubDate)}</time></p>
      {project.data.techStack.length > 0 && <div class="tech-stack">{project.data.techStack.map((tech) => <span>{tech}</span>)}</div>}
      {(project.data.github || project.data.demo || (project.data.appStore && project.slug !== 'erha-buddy')) && <div class="project-actions">{project.data.github && <a href={project.data.github}>View on GitHub</a>}{project.data.demo && <a href={project.data.demo}>Live demo</a>}{project.data.appStore && project.slug !== 'erha-buddy' && <a href={project.data.appStore}>View on App Store</a>}</div>}
    </header>
    {project.data.thumbnail && <figure class="cover"><ContentImage src={project.data.thumbnail} alt={`${project.data.title} portfolio cover`} eager /></figure>}
    {sections.length >= 4 && <details class="article-contents" open>
      <summary>On this page</summary>
      <nav aria-label="Case study sections"><ol>{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav>
    </details>}
    <div class="content"><Content /></div>
    <ProjectGallery />
    {project.slug === 'erha-buddy' && project.data.appStore && <a class="app-campaign-action" href={project.data.appStore}><img src="/app-store-badge.png" alt="Download ERHA Buddy on the App Store" width="1200" height="800" loading="lazy" /></a>}
    <footer class="project-footer"><a href="/portfolio.pdf" download>Download portfolio PDF</a></footer>
  </article>
</Base>
