---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
const projects = (await getCollection('projects')).filter((project) => !project.data.draft).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
---
<Base title="Projects"><header class="page-header"><p class="page-kicker">selected work</p><h1>Projects</h1></header><ul class="listing">{projects.map((project) => <li><a href={`/projects/${project.slug}/`}>{project.data.title}</a>{project.data.description && <span>{project.data.description}</span>}<span class="date">{new Date(project.data.pubDate).toLocaleDateString('en-US')}</span></li>)}</ul></Base>
