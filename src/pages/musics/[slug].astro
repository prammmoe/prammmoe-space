---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
export async function getStaticPaths() { return (await getCollection('musics')).map((item) => ({ params: { slug: item.slug }, props: { item } })) }
const { item } = Astro.props
const { Content } = await item.render()
---
<Base title={item.data.title} description={item.data.description}><article class="post"><a class="back-link" href="/musics/">← back to music</a><header class="article-header"><p class="page-kicker">music</p><h1>{item.data.title}</h1><p class="meta">{new Date(item.data.pubDate).toLocaleDateString('en-US')}</p></header><div class="content"><Content /></div></article></Base>
