---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
const items = (await getCollection('musics')).filter((item) => !item.data.draft).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
---
<Base title="Music I Listened To"><header class="page-header"><p class="page-kicker">personal notes</p><h1>Music I Listened To</h1></header><ul class="listing">{items.map((item) => <li><a href={`/musics/${item.slug}/`}>{item.data.title}</a><span class="date">{new Date(item.data.pubDate).toLocaleDateString('en-US')}</span></li>)}</ul></Base>
