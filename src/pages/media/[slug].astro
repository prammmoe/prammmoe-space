---
import Base from '../../layouts/Base.astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { formatDate } from '../../data/profile'
export async function getStaticPaths() { return (await getCollection('media')).filter((item) => !item.data.draft).map((item) => ({ params: { slug: item.slug }, props: { item } })) }
interface Props { item: CollectionEntry<'media'> }
const { item } = Astro.props
const { Content } = await item.render()
---
<Base title={item.data.title} description={item.data.description || `Personal media notes: ${item.data.title}.`} lang={item.data.lang}>
  <article class="post"><a class="back-link" href="/media/">Back to media</a><header class="article-header"><h1>{item.data.title}</h1><p class="meta"><time datetime={item.data.pubDate.toISOString()}>{formatDate(item.data.pubDate, item.data.lang)}</time></p></header><div class="content"><Content /></div></article>
</Base>
