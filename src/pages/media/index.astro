---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { formatDate } from '../../data/profile'
const items = (await getCollection('media')).filter((item) => !item.data.draft).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---
<Base title="Media" description="Pram’s personal notes on books, films, and other media.">
  <header class="page-header"><h1>Media</h1><p>Personal notes on what I read and watch.</p></header>
  {items.length ? <ul class="listing">{items.map((item) => <li><a href={`/media/${item.slug}/`}>{item.data.title}</a><time class="date" datetime={item.data.pubDate.toISOString()}>{formatDate(item.data.pubDate)}</time></li>)}</ul> : <p class="empty-state">No media notes published yet.</p>}
</Base>
