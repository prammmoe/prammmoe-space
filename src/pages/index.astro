---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'

const articles = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
---
<Base home title="Pramuditha Muhammad Ikhwan — iOS Developer" description="Portfolio of Pramuditha Muhammad Ikhwan, Software Engineer and iOS Developer.">
  <article class="home-intro">
    <div class="home-feature"><img src="/pram.JPG" alt="Pramuditha Muhammad Ikhwan" /><div><p class="page-kicker">about me</p><h1>Pramuditha Muhammad Ikhwan</h1><p class="role">Software Engineer · iOS Developer</p><p>Hello, I’m Pram. I build digital products and keep notes on work, technology, and the things I enjoy.</p><p class="quick-links"><a href="https://leetcode.com/prammmoe" target="_blank" rel="noopener noreferrer">LeetCode</a> · <a href="https://medium.com/@prammmoe" target="_blank" rel="noopener noreferrer">Medium</a> · <a href="https://www.upwork.com/freelancers/prammmoe" target="_blank" rel="noopener noreferrer">Upwork</a></p></div></div>
    <section class="article-section"><h2>articles</h2><ul class="article-list">{articles.map((post) => <li><a href={`/blog/${post.slug}/`}>{post.data.title}</a>{post.data.description && <p>{post.data.description}</p>}<span>{new Date(post.data.pubDate).toLocaleDateString('en-US')}</span></li>)}</ul><a class="more-articles" href="/blog/">view all articles...</a></section>
  </article>

  <section slot="sidebar" class="notice-panel"><p>currently</p><strong>iOS Developer<br />at Arya Noble</strong></section>
  <section slot="sidebar" class="sidebar-section sidebar-blue profile-sidebar"><h2>experience</h2><dl class="side-timeline"><div><dt>Arya Noble</dt><dd>iOS Developer<br /><span>2026 — present</span></dd></div><div><dt>4TITU PTE LTD</dt><dd>Full Stack Developer<br /><span>2025 — 2026</span></dd></div><div><dt>Apple Developer Academy</dt><dd>iOS Developer<br /><span>2025</span></dd></div><div><dt>PT Widya Inovasi</dt><dd>System Analyst<br /><span>2023</span></dd></div></dl></section>
  <section slot="sidebar" class="sidebar-section sidebar-yellow profile-sidebar"><h2>education</h2><dl class="side-timeline"><div><dt>Apple Developer Academy</dt><dd>Learner, Cohort 6<br /><span>2025</span></dd></div><div><dt>Universitas Negeri Yogyakarta</dt><dd>Information Technology<br /><span>2021 — 2025</span></dd></div><div><dt>Bangkit Academy</dt><dd>Mobile Development<br /><span>2024 — 2025</span></dd></div></dl></section>
  <section slot="sidebar" class="sidebar-section sidebar-green"><h2>documents</h2><a href="/resume.pdf" download>Download resume</a><a href="/portfolio.pdf" download>Download portfolio</a></section>

  <style>
    .home-feature{border-bottom:1px solid var(--rule);display:grid;gap:1rem;grid-template-columns:10.5rem minmax(0,1fr);padding-bottom:1.15rem}.home-feature img{aspect-ratio:1/1;border:1px solid var(--rule);object-fit:cover;width:100%}.role{color:#ff1600;font-size:1.05rem;margin:.3rem 0 .75rem}.home-feature p:not(.page-kicker):not(.role){margin:0 0 .7rem}.quick-links{font-size:.88rem}.article-section{margin-top:1.6rem}.article-section h2{font-size:1.7rem}.article-list{list-style:none;margin:0;padding:0}.article-list li{border-bottom:1px solid var(--rule);padding:1rem 0}.article-list a{color:var(--blue);display:block;font-size:clamp(2rem,2.4vw,2.5rem);font-weight:bold;line-height:1.12}.article-list p{color:var(--blue);font-size:1.6rem;line-height:1.35;margin:.35rem 0}.article-list span{color:var(--blue);font-size:1.2rem}.more-articles{color:var(--blue);display:block;font-size:1.5rem;font-style:italic;margin-top:.8rem;text-align:right}.profile-sidebar h2{font-size:1.8rem}.side-timeline{margin:0}.side-timeline div{border-top:1px solid var(--rule);padding:.7rem 0}.side-timeline dt{font-size:1.45rem;font-weight:bold}.side-timeline dd{font-size:1.3rem;line-height:1.2;margin:.18rem 0 0}.side-timeline span{color:var(--muted);font-size:1.15rem}@media(max-width:430px){.home-feature{grid-template-columns:6.5rem minmax(0,1fr)}.article-list a{font-size:2rem}.article-list p{font-size:1.45rem}}
  </style>
</Base>
