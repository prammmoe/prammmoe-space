        </div>
        
        <!-- Download Section -->
        <div class="download-section">
          <span class="download-label">Download</span>
          <div class="download-links">
            <a href="/resume.pdf" download class="download-link" title="Download Resume">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Resume</span>
            </a>
            <a href="/portfolio.pdf" download class="download-link" title="Download Portfolio">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              <span>Portfolio</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Background Sections -->
    <div class="background-container">
      <!-- Educational Background -->
      <div class="background-section">
        <h2 class="section-title">Educational Background</h2>
        
        <div class="background-item">
          <h3 class="item-title">Apple Developer Academy @ Infinite Learning</h3>
          <p class="item-subtitle">Learner Cohort 6</p>
          <p class="item-date">Feb 2025 - Dec 2025</p>
        </div>
        
        <div class="background-item">
          <h3 class="item-title">Universitas Negeri Yogyakarta</h3>
          <p class="item-subtitle">Majoring in Information Technology</p>
          <p class="item-date">Aug 2021 - May 2025</p>
        </div>
        
        <div class="background-item">
          <h3 class="item-title">Bangkit Academy</h3>
          <p class="item-subtitle">Mobile Development Cohort</p>
          <p class="item-date">Sep 2024 - Jan 2025</p>
        </div>
      </div>

      <!-- Professional Background -->
      <div class="background-section">
        <h2 class="section-title">Professional Background</h2>
        
         <div class="background-item">
          <h3 class="item-title">Arya Noble (ERHA Clinic)</h3>
          <p class="item-subtitle">iOS Developer</p>
          <p class="item-date">Mar 2026 - Present</p>
        </div>
        
        <div class="background-item">
          <h3 class="item-title">4TITU PTE LTD</h3>
          <p class="item-subtitle">Full Stack Developer</p>
          <p class="item-date">Aug 2025 - Mar 2026</p>
        </div>
        
        <div class="background-item">
          <h3 class="item-title">Apple Developer Academy @ Infinite Learning</h3>
          <p class="item-subtitle">iOS Developer</p>
          <p class="item-date">Feb 2025 - Dec 2025</p>
        </div>
        
        <div class="background-item">
          <h3 class="item-title">PT Widya Inovasi Indonesia</h3>
          <p class="item-subtitle">System Analyst</p>
          <p class="item-date">Aug 2023 - Dec 2023</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      padding-bottom: 4rem;
    }

    /* Decorative circle gradient in top right */
    .decorative-circle {
      position: absolute;
      top: -100px;
      right: -100px;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(60, 60, 60, 0.4) 0%, rgba(40, 40, 40, 0.2) 40%, transparent 70%);
      pointer-events: none;
      opacity: 0.6;
    }

    .decorative-circle::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 300px;
      height: 300px;
      border-radius: 50%;
      border: 1px solid rgba(100, 100, 100, 0.2);
    }

    .decorative-circle::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 200px;
      height: 200px;
      border-radius: 50%;
      border: 1px solid rgba(100, 100, 100, 0.15);
    }

    /* Profile Section */
    .profile-section {
      display: flex;
      gap: 2rem;
      align-items: flex-start;
      margin-bottom: 4rem;
      animation: fadeInUp 0.8s ease-out;
    }

    .profile-image {
      flex-shrink: 0;
    }

    .profile-image img {
      width: 200px;
      height: 200px;
      object-fit: cover;
      border-radius: 50%;
    }

    .profile-info {
      padding-top: 0.5rem;
    }

    .name {
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 600;
      margin: 0 0 0.25rem 0;
      color: var(--text);
      letter-spacing: -0.02em;
    }

    .title {
      font-size: 1rem;
      color: var(--muted);
      margin: 0 0 1.5rem 0;
    }

    .bio {
      font-size: 1.1rem;
      line-height: 1.6;
      color: var(--muted);
      margin: 0;
      max-width: 400px;
      font-style: normal;
      font-weight: 200;
    }

    /* Connect Section */
    .connect-section {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .connect-label {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .social-links {
      display: flex;
      gap: 0.75rem;
    }

    .social-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      color: var(--muted);
      transition: all 0.2s ease;
    }

    .social-link:hover {
      background: rgba(255, 255, 255, 0.15);
      color: var(--text);
      transform: translateY(-2px);
    }

    .social-link svg {
      width: 18px;
      height: 18px;
    }

    /* Download Section */
    .download-section {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1rem;
    }

    .download-label {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .download-links {
      display: flex;
      gap: 0.75rem;
    }

    .download-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.08);
      color: var(--muted);
      font-size: 0.9rem;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .download-link:hover {
      background: rgba(255, 255, 255, 0.15);
      color: var(--text);
      transform: translateY(-2px);
    }

    .download-link svg {
      width: 16px;
      height: 16px;
    }

    /* Background Sections */
    .background-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      margin-top: 3rem;
      animation: fadeInUp 0.8s ease-out 0.2s both;
    }

    .background-section {
      /* Each section */
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text);
      margin: 0 0 1.5rem 0;
      letter-spacing: -0.01em;
    }

    .background-item {
      margin-bottom: 1.5rem;
    }

    .item-title {
      font-size: 1rem;
      font-weight: 500;
      color: #ffffff;
      margin: 0 0 0.25rem 0;
    }

    .item-subtitle {
      font-size: 0.9rem;
      color: var(--muted);
      margin: 0 0 0.15rem 0;
    }

    .item-date {
      font-size: 0.8rem;
      color: rgba(177, 175, 166, 0.6);
      margin: 0;
    }

    /* Animations */
    @keyframes fadeInUp {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Responsive */
    @media (max-width: 768px) {
      .profile-section {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .profile-info {
        padding-top: 0;
      }

      .bio {
        max-width: 100%;
      }

      .background-container {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .decorative-circle {
        width: 250px;
        height: 250px;
        top: -80px;
        right: -80px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .profile-section,
      .background-container {
        animation: none;
      }
    }
  </style>
</Base>