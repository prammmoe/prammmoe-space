---
import Base from '../layouts/Base.astro'
 
---
<Base title="Beranda">
  <section class="hero">
    <div class="hero-inner">
      <h1 class="quote">Hi, I am Pram.</h1>
      <p class="intro-sub">An aspiring iOS Engineer.</p>
    </div>
  </section>
  <footer class="site-footer">
    <ul class="posts"></ul>
  </footer>
  <script is:inline>
    const h = document.querySelector('.hero .quote');
    const s = document.querySelector('.hero .intro-sub');
    if (h) { h.classList.remove('animate'); void h.offsetWidth; h.classList.add('animate'); }
    if (s) { s.classList.remove('animate'); void s.offsetWidth; s.classList.add('animate'); }
  </script>
  <style>
  .hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    position: relative;
  }

  .hero-inner {
    max-width: 840px;
    margin: 0;
    text-align: left;
  }

  /* Besarkan tulisan hero */
  .quote {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.1;
  }

  .intro-sub {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    color: var(--muted);
  }

  .quote.animate {
    animation: intro-reveal 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    will-change: transform, opacity, filter;
  }

  .intro-sub.animate {
    animation: intro-fade 600ms 300ms ease both;
    will-change: transform, opacity;
  }

  @keyframes intro-reveal {
    0% { opacity: 0; transform: translateY(12px) scale(0.98); filter: blur(6px); letter-spacing: 0.02em; }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); letter-spacing: 0em; }
  }

  @keyframes intro-fade {
    0% { opacity: 0; transform: translateY(6px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .quote.animate, .intro-sub.animate { animation: none; }
  }

 

  .posts {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0 0;
  }

  .posts li {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .date {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .site-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    position: relative;
    max-width: 840px;
    margin: 0;
  }
</style>

</Base>