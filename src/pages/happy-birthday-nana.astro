---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Happy birthday, Nana sayang! &lt;3</title>
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#f0f0f0" />
  </head>
  <body>
    <main class="birthday-stage">
      <article class="birthday-poster" aria-labelledby="birthday-title">
        <svg class="scribble-border" viewBox="0 0 720 1200" preserveAspectRatio="none" aria-hidden="true">
          <path d="M54 52 C116 45 181 57 247 50 C320 44 389 56 458 49 C534 42 604 57 664 51 C681 49 679 84 675 116 C668 176 680 231 674 294 C668 360 681 424 674 489 C668 558 680 626 674 694 C668 765 681 832 674 901 C668 968 681 1038 675 1103 C673 1134 681 1155 662 1150 C599 1141 537 1155 469 1148 C398 1142 326 1155 256 1148 C184 1142 119 1155 56 1148 C39 1146 46 1113 48 1081 C54 1018 42 948 49 881 C55 812 42 742 49 675 C55 605 42 537 49 469 C55 401 42 333 49 265 C55 195 41 127 48 70 C49 58 50 53 54 52 Z" />
        </svg>

        <div class="ornament ornament-disko reveal" aria-hidden="true">
          <img src="/images/disko.png" alt="" />
        </div>
        <div class="ornament ornament-ribbon reveal" aria-hidden="true">
          <img src="/images/ily.png" alt="" />
        </div>
        <div class="ornament ornament-flower reveal" aria-hidden="true">
          <img src="/images/flower.png" alt="" />
        </div>

        <header class="poster-copy">
          <p class="invitation">A super special message just for you</p>
          <h1 id="birthday-title">Happy birthday,<br /><span>Nana sayang!</span></h1>
          <p class="wish">Today is all about you, the prettiest star in the whole universe.</p>
        </header>

        <figure class="portrait reveal">
          <img
            class="portrait-photo"
            src="/images/happy-birthday.jpeg"
            alt="Nana standing in front of blue patterned tiles with a handwritten happy birthday message"
          />
          <span class="party-hat" aria-hidden="true">
            <img src="/images/topi.png" alt="" />
          </span>
        </figure>

        <footer class="poster-footer">
          <button class="music-button" type="button" aria-pressed="false">
            Play the birthday beat
          </button>
          <p>Made with lots and lots of love.</p>
        </footer>
      </article>
    </main>

    <script>
      const button = document.querySelector<HTMLButtonElement>('.music-button')

      if (button) {
        const musicButton = button
        let context: AudioContext | undefined
        let compressor: DynamicsCompressorNode | undefined
        let timer: number | undefined
        let playing = false
        const melody: Array<[number, number]> = [
          [392, .28], [392, .28], [440, .56], [392, .56], [523.25, .56], [493.88, 1],
          [392, .28], [392, .28], [440, .56], [392, .56], [587.33, .56], [523.25, 1],
          [392, .28], [392, .28], [783.99, .56], [659.25, .56], [523.25, .56], [493.88, .56], [440, 1],
        ]

        function playNote(frequency: number, start: number, duration: number) {
          if (!context || !compressor) return
          const oscillator = context.createOscillator()
          const gain = context.createGain()
          oscillator.type = 'triangle'
          oscillator.frequency.value = frequency
          gain.gain.setValueAtTime(.0001, start)
          gain.gain.exponentialRampToValueAtTime(.8, start + .03)
          gain.gain.exponentialRampToValueAtTime(.0001, start + duration)
          oscillator.connect(gain).connect(compressor)
          oscillator.start(start)
          oscillator.stop(start + duration + .04)
        }

        function playLoop() {
          if (!context) return
          const now = context.currentTime + .06
          let offset = 0
          melody.forEach(([frequency, duration]) => {
            playNote(frequency, now + offset, duration)
            offset += duration
          })
          timer = window.setTimeout(playLoop, (offset + .25) * 1000)
        }

        async function toggleMusic() {
          if (playing && context) {
            window.clearTimeout(timer)
            await context.close()
            context = undefined
            compressor = undefined
            playing = false
            musicButton.textContent = 'Play the birthday beat'
            musicButton.setAttribute('aria-pressed', 'false')
            return
          }

          context = new AudioContext()
          compressor = context.createDynamicsCompressor()
          compressor.threshold.value = -12
          compressor.knee.value = 20
          compressor.ratio.value = 12
          compressor.attack.value = .003
          compressor.release.value = .25
          compressor.connect(context.destination)
          await context.resume()
          playing = true
          musicButton.textContent = 'Pause the birthday beat'
          musicButton.setAttribute('aria-pressed', 'true')
          playLoop()
        }

        musicButton.addEventListener('click', toggleMusic)
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(:root) {
    --canvas: #f0f0f0;
    --paper: #fffdf7;
    --ink: #171717;
    --burgundy: #a92d35;
    --mustard: #dfac32;
    --ease-out: cubic-bezier(.23, 1, .32, 1);
    --ease-in-out: cubic-bezier(.77, 0, .175, 1);
  }

  :global(html) {
    background: var(--canvas);
    min-height: 100%;
  }

  :global(body) {
    background: var(--canvas);
    color: var(--ink);
    margin: 0;
    min-height: 100svh;
    overflow-x: hidden;
  }

  :global(button) { font: inherit; }

  .birthday-stage {
    display: grid;
    min-height: 100svh;
    padding: clamp(1rem, 4vw, 3rem);
    place-items: start center;
  }

  .birthday-poster {
    animation: poster-enter 600ms var(--ease-out) both;
    background: var(--paper);
    box-shadow: .65rem .75rem 0 rgba(23, 23, 23, .12);
    isolation: isolate;
    max-width: 45rem;
    min-height: 64rem;
    overflow: hidden;
    padding: clamp(4.75rem, 10vw, 7rem) clamp(2.25rem, 8vw, 5.5rem) clamp(3rem, 7vw, 5rem);
    position: relative;
    text-align: center;
    width: 100%;
  }

  .scribble-border {
    height: 100%;
    inset: 0;
    pointer-events: none;
    position: absolute;
    width: 100%;
    z-index: 5;
  }

  .scribble-border path {
    fill: none;
    stroke: var(--mustard);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
    vector-effect: non-scaling-stroke;
  }

  .poster-copy,
  .portrait,
  .poster-footer {
    position: relative;
    z-index: 2;
  }

  .invitation {
    font-family: 'Bradley Hand', 'Marker Felt', 'Comic Sans MS', cursive;
    font-size: clamp(1rem, 2.8vw, 1.35rem);
    letter-spacing: .14em;
    margin: 0 auto 1.5rem;
    max-width: 26rem;
  }

  h1 {
    color: var(--ink);
    font-family: 'Bradley Hand', 'Marker Felt', 'Comic Sans MS', cursive;
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: .87;
    margin: 0;
    transform: rotate(-1.2deg);
  }

  h1 span {
    color: var(--burgundy);
    display: inline-block;
    margin-top: .35rem;
  }

  .wish {
    font-family: 'Bradley Hand', 'Marker Felt', 'Comic Sans MS', cursive;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 700;
    line-height: 1.5;
    margin: 1.6rem auto 2rem;
    max-width: 27rem;
  }

  .portrait {
    animation-delay: 120ms;
    margin: 0 auto;
    width: min(72%, 22rem);
  }

  .portrait::before {
    background: var(--mustard);
    content: '';
    inset: .55rem -.55rem -.55rem .55rem;
    position: absolute;
    transform: rotate(1.1deg);
    z-index: -1;
  }

  .portrait-photo {
    border: 2px solid var(--ink);
    display: block;
    height: auto;
    position: relative;
    width: 100%;
    z-index: 1;
  }

.party-hat {
  left: 23%;
  position: absolute;
  top: 41%;
  transform: rotate(-12deg);
  width: 12%;
  z-index: 3;
}

  .party-hat img,
  .ornament img {
    display: block;
    height: auto;
    width: 100%;
  }

  .party-hat img { animation: hat-drift 5.5s var(--ease-in-out) -1.2s infinite alternate; }

  .poster-footer {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: .9rem;
    margin-top: 2.5rem;
  }

  .music-button {
    background: var(--burgundy);
    border: 2px solid var(--ink);
    box-shadow: .28rem .3rem 0 var(--ink);
    color: var(--paper);
    cursor: pointer;
    font-family: 'Courier New', monospace;
    font-size: .82rem;
    font-weight: 700;
    min-height: 2.75rem;
    padding: .7rem 1rem;
    text-transform: lowercase;
    transition: transform 140ms var(--ease-out);
  }

  .music-button:hover,
  .music-button[aria-pressed='true'] {
    background: var(--ink);
  }

  .music-button:active { transform: scale(.97); }

  .music-button:focus-visible {
    outline: 3px solid var(--mustard);
    outline-offset: 5px;
  }

  .poster-footer p {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: .85rem;
    font-style: italic;
    margin: 0;
  }

  .ornament {
    pointer-events: none;
    position: absolute;
    z-index: 3;
  }

  .ornament-disko {
    animation-delay: 180ms;
    right: 2.2rem;
    top: 2rem;
    width: clamp(5rem, 17vw, 8rem);
  }

  .ornament-disko img { animation: disco-spin 18s linear infinite; }

  .ornament-ribbon {
    animation-delay: 240ms;
    left: -.65rem;
    top: 38%;
    width: clamp(5rem, 17vw, 8.5rem);
  }

  .ornament-ribbon img { animation: ribbon-drift 6.5s var(--ease-in-out) -2.4s infinite alternate; }

  .ornament-flower {
    animation-delay: 300ms;
    bottom: 4.5rem;
    right: -.2rem;
    width: clamp(5.5rem, 19vw, 9.5rem);
    z-index: 1;
  }

  .ornament-flower img { animation: flower-drift 7.5s var(--ease-in-out) -4.1s infinite alternate; }

  .reveal {
    animation-duration: 500ms;
    animation-fill-mode: both;
    animation-name: reveal-item;
    animation-timing-function: var(--ease-out);
  }

  @keyframes poster-enter {
    from { opacity: 0; transform: translateY(12px) scale(.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes reveal-item {
    from { opacity: 0; transform: translateY(12px) scale(.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes disco-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes hat-drift {
    from { transform: translateY(0) rotate(-1deg); }
    to { transform: translateY(-6px) rotate(1deg); }
  }

  @keyframes ribbon-drift {
    from { transform: translateY(0) rotate(-2deg); }
    to { transform: translateY(-6px) rotate(2deg); }
  }

  @keyframes flower-drift {
    from { transform: translateY(0) rotate(2deg); }
    to { transform: translateY(-6px) rotate(-2deg); }
  }

  @media (max-width: 560px) {
    .birthday-stage { padding: 0; }

    .birthday-poster {
      box-shadow: none;
      min-height: 100svh;
      padding: 5.4rem 2.8rem 4rem;
    }

    .portrait { width: min(82%, 20rem); }

    .ornament-disko {
      right: 1.15rem;
      top: 1.15rem;
      width: 5.6rem;
    }

    .ornament-ribbon {
      left: -.75rem;
      top: 40%;
      width: 5.6rem;
    }

    .ornament-flower {
      bottom: 4.75rem;
      right: -.75rem;
      width: 6rem;
    }
  }

  @media (max-width: 380px) {
    .birthday-poster { padding-inline: 2.3rem; }
    .invitation { max-width: 14rem; }
    .portrait { width: 86%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .birthday-poster,
    .reveal {
      animation: reduced-enter 200ms ease both;
    }

    .party-hat img,
    .ornament img { animation: none; }

    .music-button { transition: none; }
    .music-button:active { transform: none; }
  }

  @keyframes reduced-enter {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
